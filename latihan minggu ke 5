import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);
        int pilihan;

        do {
            System.out.println("\n===== MENU PROGRAM JAVA =====");
            System.out.println("1. Cek Genap atau Ganjil");
            System.out.println("2. Cek Positif, Negatif, atau Nol");
            System.out.println("3. Menentukan Grade dan Status Lulus");
            System.out.println("4. Mengubah Angka Menjadi Nama Hari");
            System.out.println("5. Kalkulator Sederhana");
            System.out.println("6. Menentukan Jenis Segitiga");
            System.out.println("0. Keluar");
            System.out.print("Pilih menu: ");

            pilihan = input.nextInt();

            switch (pilihan) {

                case 1:
                    // Cek Genap atau Ganjil
                    System.out.print("Masukkan angka: ");
                    int angka = input.nextInt();

                    if (angka % 2 == 0) {
                        System.out.println("Angka Genap");
                    } else {
                        System.out.println("Angka Ganjil");
                    }
                    break;

                case 2:
                    // Cek Positif, Negatif, atau Nol
                    System.out.print("Masukkan angka: ");
                    int bilangan = input.nextInt();

                    if (bilangan > 0) {
                        System.out.println("Bilangan Positif");
                    } else if (bilangan < 0) {
                        System.out.println("Bilangan Negatif");
                    } else {
                        System.out.println("Bilangan Nol");
                    }
                    break;

                case 3:
                    // Menentukan Grade dan Status Lulus
                    System.out.print("Masukkan nilai: ");
                    int nilai = input.nextInt();

                    if (nilai < 0 || nilai > 100) {
                        System.out.println("Nilai tidak valid");
                    } else {
                        String grade;

                        if (nilai >= 85) {
                            grade = "A";
                        } else if (nilai >= 75) {
                            grade = "B";
                        } else if (nilai >= 65) {
                            grade = "C";
                        } else {
                            grade = "D";
                        }

                        String status = (nilai >= 55) ?
                                "Lulus" : "Tidak Lulus";

                        System.out.println("Grade: " + grade);
                        System.out.println("Status: " + status);
                    }
                    break;

                case 4:
                    // Mengubah Angka Menjadi Nama Hari
                    System.out.print("Masukkan angka 1-7: ");
                    int hari = input.nextInt();

                    switch (hari) {
                        case 1:
                            System.out.println("Senin");
                            break;
                        case 2:
                            System.out.println("Selasa");
                            break;
                        case 3:
                            System.out.println("Rabu");
                            break;
                        case 4:
                            System.out.println("Kamis");
                            break;
                        case 5:
                            System.out.println("Jumat");
                            break;
                        case 6:
                            System.out.println("Sabtu");
                            break;
                        case 7:
                            System.out.println("Minggu");
                            break;
                        default:
                            System.out.println("Angka tidak valid");
                    }
                    break;

                case 5:
                    // Kalkulator Sederhana
                    System.out.print("Masukkan angka pertama: ");
                    double a = input.nextDouble();

                    System.out.print("Masukkan operator (+, -, *, /, %): ");
                    char operator = input.next().charAt(0);

                    System.out.print("Masukkan angka kedua: ");
                    double b = input.nextDouble();

                    switch (operator) {
                        case '+':
                            System.out.println("Hasil: " + (a + b));
                            break;
                        case '-':
                            System.out.println("Hasil: " + (a - b));
                            break;
                        case '*':
                            System.out.println("Hasil: " + (a * b));
                            break;
                        case '/':
                            if (b != 0) {
                                System.out.println("Hasil: " + (a / b));
                            } else {
                                System.out.println("Tidak bisa dibagi nol");
                            }
                            break;
                        case '%':
                            if (b != 0) {
                                System.out.println("Hasil: " + (a % b));
                            } else {
                                System.out.println("Tidak bisa dibagi nol");
                            }
                            break;
                        default:
                            System.out.println("Operator tidak valid");
                    }
                    break;

                case 6:
                    // Menentukan Jenis Segitiga
                    System.out.print("Masukkan sisi pertama: ");
                    int s1 = input.nextInt();

                    System.out.print("Masukkan sisi kedua: ");
                    int s2 = input.nextInt();

                    System.out.print("Masukkan sisi ketiga: ");
                    int s3 = input.nextInt();

                    if (s1 <= 0 || s2 <= 0 || s3 <= 0) {
                        System.out.println("Bukan Segitiga");
                    } else if (s1 + s2 <= s3 ||
                               s1 + s3 <= s2 ||
                               s2 + s3 <= s1) {
                        System.out.println("Bukan Segitiga");
                    } else if (s1 == s2 && s2 == s3) {
                        System.out.println("Segitiga Sama Sisi");
                    } else if (s1 == s2 || s1 == s3 ||
                               s2 == s3) {
                        System.out.println("Segitiga Sama Kaki");
                    } else {
                        System.out.println("Segitiga Sembarang");
                    }
                    break;

                case 0:
                    System.out.println("Program Selesai. Terima Kasih!");
                    break;

                default:
                    System.out.println("Pilihan tidak tersedia!");
            }

        } while (pilihan != 0);

        input.close();
    }
}
